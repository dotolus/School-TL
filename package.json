{
  "name": "eq-ppt",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:server": "nodemon server/index.js",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently -n server,client -c green,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm install --prefix client && npm run build --prefix client",
    "start": "node server/index.js",
    "install:client": "npm install --prefix client"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.7"
  }
}

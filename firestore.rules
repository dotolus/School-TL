rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // All reads/writes go through server/services/persistence/firestoreAdapter.js
      // using the firebase-admin SDK, which always bypasses these rules. No
      // client-side Firestore SDK talks to this project, so direct access is
      // denied outright rather than left open on the default 30-day timer.
      allow read, write: if false;
    }
  }
}

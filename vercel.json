{
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "client/dist/**"
    }
  },
  "crons": [{ "path": "/api/backup/run", "schedule": "0 6 * * 0" }]
}

PORT=4000
ADMIN_PASSWORD=changeme
SESSION_SECRET=change-this-session-secret
SCHEDULER_CRON=0 6 * * *

# MongoDB Atlas connection string (events + their history live here now).
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=yourApp
MONGODB_DB_NAME=eq_ppt

# Which school/class/period dataset this server instance serves. Several
# datasets can coexist in the same Mongo collection; switching means
# changing these and redeploying (no admin UI for it yet).
ACTIVE_SCHOOL=reut
ACTIVE_CLASS=e4
ACTIVE_PERIOD=2026-2027

# Cloudinary account for event images. If left unset, image uploads fall
# back to inline data URIs instead of failing (see server/services/imageStore.js).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PORT=4000
ADMIN_PASSWORD=changeme
SESSION_SECRET=change-this-session-secret
SCHEDULER_CRON=0 6 * * *

# Firebase project credentials (production). Firebase console -> Project
# settings -> Service accounts -> Generate new private key -> paste the
# entire downloaded JSON as one line here. Keep this out of version control.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional; normally inferred from the service account's own project_id.
# Only needed to target a different project, or for local emulator use.
FIREBASE_PROJECT_ID=

# Local dev against the Firestore emulator instead of a real project (no
# credentials needed, nothing leaves your machine):
#   1. npm run emulator:firestore
#   2. set FIRESTORE_EMULATOR_HOST=localhost:8080 before `npm run dev`
#      (firebase-admin reads this env var natively).

# Which school/class/period dataset this server instance serves. Several
# datasets can coexist in the same Firestore project; switching means
# changing these and redeploying (no admin UI for it yet).
ACTIVE_SCHOOL=reut
ACTIVE_CLASS=e4
ACTIVE_PERIOD=2026-2027

# Cloudinary account for event file attachments. If left unset, uploads fall
# back to inline data URIs instead of failing (see server/services/fileStore.js).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Full-dataset backups (server/services/backupStore.js). BACKUP_CRON is how
# often a check happens; BACKUP_MIN_INTERVAL_DAYS is the real cadence
# (cron has no native "every N weeks" syntax) - defaults to checking every
# Sunday and backing up at most once every 14 days.
BACKUP_CRON=0 6 * * 0
BACKUP_MIN_INTERVAL_DAYS=14

# Required in production on Vercel for GET /api/backup/run (the endpoint
# vercel.json's `crons` entry hits, since node-cron's own scheduler never
# runs on a serverless deployment - see CLAUDE.md's Backups section). Set
# this as a Vercel project env var; Vercel then automatically sends
# `Authorization: Bearer <CRON_SECRET>` to that route on its own. Not needed
# for `npm start` (node-cron handles it there instead).
CRON_SECRET=
